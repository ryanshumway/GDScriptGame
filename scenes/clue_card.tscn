[gd_scene format=3]

[ext_resource type="Script" path="res://scripts/clue_card.gd" id="1_card"]

[node name="ClueCard" type="CanvasLayer"]
process_mode = 3
script = ExtResource("1_card")

[node name="Panel" type="PanelContainer" parent="."]
anchors_preset = 8
anchor_left = 0.5
anchor_top = 0.5
anchor_right = 0.5
anchor_bottom = 0.5
grow_horizontal = 2
grow_vertical = 2
custom_minimum_size = Vector2(420, 0)

[node name="Padding" type="MarginContainer" parent="Panel"]
theme_override_constants/margin_left = 24
theme_override_constants/margin_top = 20
theme_override_constants/margin_right = 24
theme_override_constants/margin_bottom = 20

[node name="Stack" type="VBoxContainer" parent="Panel/Padding"]
theme_override_constants/separation = 16

[node name="Title" type="Label" parent="Panel/Padding/Stack"]
unique_name_in_owner = true
text = "Clue found!"
theme_override_font_sizes/font_size = 28

[node name="Description" type="Label" parent="Panel/Padding/Stack"]
unique_name_in_owner = true
text = "Description goes here."
autowrap_mode = 3
theme_override_font_sizes/font_size = 18

[node name="CloseButton" type="Button" parent="Panel/Padding/Stack"]
unique_name_in_owner = true
size_flags_horizontal = 8
text = "Got it"
